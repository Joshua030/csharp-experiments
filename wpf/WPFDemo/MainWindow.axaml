<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="350"
        x:Class="WPFDemo.MainWindow"
        xmlns:vm="clr-namespace:WPFDemo.Data"
        x:DataType="vm:Person"
        Title="WPFDemo">
    <!-- <Grid>
    <ContentControl x:Name="MainContent" />

    <Grid.RowDefinitions>
    <RowDefinition Height = "10" />
    <RowDefinition Height = "Auto" />
    <RowDefinition Height = "Auto" />
    <RowDefinition Height = "10" />
    <RowDefinition Height = "*" />
    <RowDefinition Height = "10" />
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
    <ColumnDefinition Width = "10" />
    <ColumnDefinition Width = "Auto" />
    <ColumnDefinition Width = "*" />
    <ColumnDefinition Width = "10" />

    </Grid.ColumnDefinitions>

    <Label Grid.Row="1" Grid.Column="1" Margin="2" Content="Name"/>

    <TextBox Text="{Binding Name, Mode=TwoWay}"  Grid.Row="1" Grid.Column="2" Margin="2" />

    <Label Content="Age" Margin="2" Grid.Column="1" Grid.Row="2" />

    <TextBox Text="{Binding Age, Mode=TwoWay}" Grid.Column="2" Grid.Row="2" Margin="2"/>
    <Button Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2"  Content="Info" Click="Button_Click" />
    </Grid> -->

    <!-- List box Example -->
    <Grid ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>

        <ListBox SelectionMode="Multiple" x:Name="ListBoxPeople" Grid.Column="1" Grid.Row="1">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:Person">
                    <StackPanel>
                        <TextBlock Text="{Binding Name, StringFormat='Name:x:False {0}'}" />
                        <TextBlock Text="{Binding Age, StringFormat='Age:  {0}'}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Column="1" Grid.Row="3" Content="Show Selected" Click="Button_Click" />
    </Grid>
</Window>
    