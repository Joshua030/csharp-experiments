<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- practices/ are reference-only solved exercises; don't compile them
         (each has its own top-level statements, which would collide with Program.cs) -->
    <Compile Remove="practices\**\*.cs" />
    <None Include="practices\**\*.cs" />
  </ItemGroup>

</Project>
